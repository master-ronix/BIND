{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wispy-rice-6aa7",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",

  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true
  },

  "routes": [
    {
      "pattern": "bangwings.xyz",
      "custom_domain": true
    }
  ],

  "workers_dev": true,
  "preview_urls": true,

  "observability": {
    "enabled": false
  }
}
