{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wispy-rice-6aa7",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",

  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": false
  }
}
